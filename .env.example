# Model used for the agent loop. qwen3:4b is the default and fits 8 GB comfortably.
# Swap to qwen2.5-coder:7b-instruct-q4_K_M for better code reasoning if you have headroom.
MCC_MODEL=qwen3:4b
MCC_EMBED_MODEL=nomic-embed-text

# Ollama defaults this to 4096 and silently truncates history. Do not leave it unset.
# Size against RAM: qwen3:4b uses ~147 KB of KV cache per token, so 16384 costs ~2.4 GB
# on top of the weights. On 8 GB that swaps and throughput collapses to ~0.1 tok/s.
# 8192 measured ~100x faster than 16384 on an 8 GB M2. Raise it only with headroom.
MCC_NUM_CTX=8192

# Max tool-calling steps in a single turn before the agent gives up.
MCC_MAX_STEPS=15

# Show the model's thinking blocks (qwen3 is a thinking model).
MCC_THINK=0

MCC_DATABASE_URL=postgresql:///mcc
